{
  "rules": {
    "honomi": {
      ".read": "auth != null && auth.token.r != null && (auth.token.sx == null || auth.token.sx * 1000 > now) && !root.child('guestOf').child(auth.uid).exists()",
      ".write": "auth != null && (auth.token.r === 'a' || auth.token.r === 's') && (auth.token.sx == null || auth.token.sx * 1000 > now) && !root.child('guestOf').child(auth.uid).exists()",
      "tc5_staff": {
        ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists()"
      },
      "tc_master_depts": {
        ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists()"
      },
      "master": {
        "locations": {
          ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists()"
        }
      },
      "tc5_pins": {
        ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists()",
        ".write": "auth != null && !root.child('guestOf').child(auth.uid).exists() && auth.token.ro != true && auth.token.r != 'x' && newData.exists()"
      },
      "tc5_records": {
        ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists()",
        ".write": "auth != null && !root.child('guestOf').child(auth.uid).exists() && auth.token.ro != true && auth.token.r != 'x' && newData.exists()",
        ".indexOn": [
          "date"
        ]
      },
      "viewerTokens": {
        "$token": {
          ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists() && $token.matches(/^[A-Za-z0-9_-]{1,64}$/)",
          ".write": "auth != null && (auth.token.r === 'a' || auth.token.r === 'd') && (auth.token.sx == null || auth.token.sx * 1000 > now) && !root.child('guestOf').child(auth.uid).exists()"
        }
      },
      "demoTokens": {
        "$token": {
          ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists() && $token.matches(/^[A-Za-z0-9_-]{1,64}$/)"
        }
      },
      "staffDemoTokens": {
        "$token": {
          ".read": "auth != null && !root.child('guestOf').child(auth.uid).exists() && $token.matches(/^[A-Za-z0-9_-]{1,64}$/)"
        }
      },
      "demoIssuedViewerTokens": {
        ".write": "auth != null && (auth.token.r === 'a' || auth.token.r === 'd') && (auth.token.sx == null || auth.token.sx * 1000 > now) && !root.child('guestOf').child(auth.uid).exists()"
      }
    },
    "members": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
        "role": {
          ".validate": "newData.val() === 'ceo' || newData.val() === 'mgr'"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "mail": {
          ".validate": "newData.isString()"
        },
        "rooms": {
          "$rid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren(['role','active'])"
      }
    },
    "config": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo'"
    },
    "field": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true",
      ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true"
    },
    "shares": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      "$sid": {
        "rid": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "token": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{22,64}$/)"
        },
        "acct": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{16,40}$/)"
        },
        "uid": {
          ".read": "auth != null && data.val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('shareKeys').child(root.child('shares').child($sid).child('token').val()).child('claimBy').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && !newData.val().contains('/')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        ".validate": "newData.hasChildren(['rid','token','acct'])"
      }
    },
    "shareKeys": {
      ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
      "$token": {
        ".read": "$token.matches(/^[A-Za-z0-9_-]{22,64}$/)",
        ".validate": "$token.matches(/^[A-Za-z0-9_-]{22,64}$/) && newData.hasChildren(['sid','acct','rid'])",
        "sid": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)"
        },
        "acct": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{16,40}$/)"
        },
        "rid": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "board": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "owner": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "claimBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !root.child('shares').child(data.parent().child('sid').val()).child('uid').exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && !newData.val().contains('/')"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "guestOf": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$rid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists() && (!data.exists() || data.val() === newData.val())",
          ".validate": "newData.isString() && root.child('shares').child(newData.val()).child('uid').val() === auth.uid && root.child('shares').child(newData.val()).child('rid').val() === $rid"
        }
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('role').val() === 'ceo' && root.child('members').child(auth.uid).child('active').val() === true",
      "$rid": {
        ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && (root.child('members').child(auth.uid).child('role').val() === 'ceo' || data.child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'ceo'",
        "name": {
          ".read": "auth != null && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('uid').val() === auth.uid && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('rid').val() === $rid",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "ownerName": {
          ".read": "auth != null && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('uid').val() === auth.uid && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('rid').val() === $rid",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "members": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "partners": {
          "$sid": {
            ".read": "auth != null && root.child('shares').child($sid).child('uid').val() === auth.uid && root.child('shares').child($sid).child('rid').val() === $rid",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "board": {
          "owner": {
            ".read": "auth != null && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('uid').val() === auth.uid && root.child('shares').child(root.child('guestOf').child(auth.uid).child($rid).val()).child('rid').val() === $rid",
            "$k": {
              ".validate": "$k.matches(/^(vision|task|output|routine)$/) && newData.hasChildren()",
              "$i": {
                ".validate": "newData.hasChildren(['id','text'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length <= 4000"
                },
                "by": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "createdAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "guest": {
            "$sid": {
              ".read": "auth != null && root.child('shares').child($sid).child('uid').val() === auth.uid && root.child('shares').child($sid).child('rid').val() === $rid",
              ".write": "auth != null && root.child('shares').child($sid).child('uid').val() === auth.uid && root.child('shares').child($sid).child('rid').val() === $rid",
              ".validate": "newData.hasChildren()",
              "$k": {
                ".validate": "$k.matches(/^(vision|task|output|routine)$/) && newData.hasChildren()",
                "$i": {
                  ".validate": "newData.hasChildren(['id','text'])",
                  "id": {
                    ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
                  },
                  "text": {
                    ".validate": "newData.isString() && newData.val().length <= 4000"
                  },
                  "by": {
                    ".validate": "newData.isString() && newData.val().length <= 128"
                  },
                  "createdAt": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
